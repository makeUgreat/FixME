# Node runtime mode. Allowed: development, test, production.
NODE_ENV=development

# API app environment. Allowed: local, development, test, production.
APP_ENV=local

PORT=3000

# Use postgres-drizzle with the local adapter Compose file.
# Use memory for a simple local runtime without Postgres.
CORRECTION_PERSISTENCE=postgres-drizzle

# Required when CORRECTION_PERSISTENCE=postgres-drizzle.
CORRECTIONS_DATABASE_URL=postgres://fixme_corrections_app:fixme_corrections_app@127.0.0.1:5432/fixme

# Required for drizzle-kit migration commands.
CORRECTIONS_MIGRATOR_DATABASE_URL=postgres://fixme_corrections_migrator:fixme_corrections_migrator@127.0.0.1:5432/fixme
